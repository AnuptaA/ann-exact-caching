# Pinned versions for the Q1 instance (sourced by the deploy scripts, read by tests).
# Minimums are what the build needs; pins are what setup builds when the system is too old.
MIN_CMAKE=3.23.1          # FAISS v1.8.0 requires 3.23.1; the Aker driver build itself needs only 3.10
MIN_BOOST=1.80            # harness/cpp/CMakeLists.txt find_package(Boost 1.80 ...)
MIN_GCC=9                 # C++17 and OpenMP
PG_MAJOR=16
PGVECTOR_VERSION=0.8.0
PGVECTOR_COMMIT=2627c5ff775ae6d7aef0c430121ccf857842d2f2   # tag v0.8.0
FAISS_VERSION=1.8.0
FAISS_COMMIT=943d08bdad7946b22f56d040756669ee444dd681       # tag v1.8.0
BOOST_VERSION=1.84.0
BOOST_URL=https://archives.boost.io/release/1.84.0/source/boost_1_84_0.tar.bz2
BOOST_SHA256=cc4b893acf645c9d4b698e9a0f08ca8846aa5d6c68275c14c3e7949c24109454
BOOST_LIBS=program_options,log,thread,system,filesystem,regex,date_time,atomic,chrono
CMAKE_PIP_VERSION=3.27.9
BLAS_VENDOR=OpenBLAS      # FAISS and the drivers must use the same BLAS (libopenblas-dev)
