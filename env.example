# ReCal environment variables. Copy to your shell profile or `source` a filled-in copy.
# Every variable is optional; defaults are shown.

# Repository root used by simulations/approximate_hits/*.sh (default: two directories above the script).
RECAL_REPO=
# Directory holding the Aker / Boost / FAISS builds and the Sphere encoders (default: $HOME/third_party).
RECAL_THIRD_PARTY=$HOME/third_party
# Job queue state of mx_run_job.sh, the watchdogs and the job runner: locks, registry, peaks, HOLD, skip list, job files.
RECAL_QUEUE_DIR=/tmp/mx
# Scratch files (timing_env samples, DiskANN AIO lock when RECAL_QUEUE_DIR does not exist).
RECAL_TMP=/tmp

# Aker's library writes its telemetry to /tmp/aker_trace_<time>_pid<PID>_gen<G>/ (hard-coded in the library; not redirected).

# cachecore/build.sh
CORE_ARCH=-march=native        # use a portable flag such as -march=x86-64-v3 for binaries moved between machines
PY=../../../.venv-core/bin/python

# Q1 harness (main) defaults, see harness/README.md and the Makefile
Q1_DATA=/data/q1
Q1_TOOLS=/opt/q1
Q1_PG_PORT=54320
Q1_PG_WORKERS=8
Q1_DEVICE=auto                 # auto | cpu | cuda | mps
Q1_LIST_SIZE=200
Q1_THREADS=                    # cores for CPU stages (default all)

# Dataset Drive folders for scripts/fetch_data.sh: folder link or ID (values in .env.local, which is git-ignored).
RECAL_DRIVE_MEDRAG=
RECAL_DRIVE_MEDRAG_100K=
RECAL_DRIVE_TRIPCLICK=
RECAL_DRIVE_TRIVIAQA=
RECAL_DRIVE_ESCI=
RECAL_DRIVE_LAION_PROMPTS=
RECAL_DRIVE_LAION=
